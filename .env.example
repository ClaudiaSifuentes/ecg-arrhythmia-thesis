# Content for the file: /ecg-arrhythmia-thesis/ecg-arrhythmia-thesis/.env.example

# This is an example environment variable file.
# Rename this file to .env and fill in the required values.

# Database configuration
DATABASE_URL=your_database_url_here

# Model configuration
MODEL_TYPE=cnn1d
NUM_CLASSES=3
INPUT_SIZE=250
DROPOUT=0.5

# Training configuration
BATCH_SIZE=32
LEARNING_RATE=0.001
EPOCHS=50

# Evaluation configuration
THRESHOLD=0.5
MIN_DURATION=5

# Logging configuration
LOG_LEVEL=INFO
LOG_FILE=logs/project.log

# Add any other environment variables as needed for your project.