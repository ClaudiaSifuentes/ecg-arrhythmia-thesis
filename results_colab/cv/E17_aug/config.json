  },
  "augment": {
    "p": 0.5,
    "gauss_std": 0.04,
    "baseline_amp": 0.15,
    "shift_max": 8,
    "scale": 0.1
  },
  "decision": {
    "t_sveb": null,
    "t_veb": null
  },
  "seeds": [
    0,
    1,
    2
  ],
  "num_threads": 1,
  "compile": true,
  "device": "auto"
}