{
  "exp_id": "E17_aug",
  "data_dir": "data/processed/mitbih_incartII_svdb",
  "exclude_patients": [],
  "model": {
    "dropout": 0.5,
    "use_rr": true
  },
  "loss": {
    "type": "focal",
    "gamma": 2.0,
    "alpha": [
      1.0,
      3.0,
      3.0
    ],
    "label_smoothing": 0.0
